APP_NAME=VYORA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# MySQL (recommended) — or use pgsql / sqlite for a quick local start.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vyora
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Mail: "log" writes emails to storage/logs. Use a real SMTP provider in production.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@vyora.test"
MAIL_FROM_NAME="${APP_NAME}"

# ---- VYORA ----------------------------------------------------------------------------------
VYORA_CONTACT_EMAIL=hello@vyora.test
VYORA_TAX_RATE=0.08
VYORA_FREE_SHIPPING_THRESHOLD=100
VYORA_REQUIRE_EMAIL_VERIFICATION=false
# Demo checkout simulates payment (NO real charge). Defaults to ON outside production, OFF in production.
# Never enable it on a live store.
VYORA_DEMO_CHECKOUT=true
VYORA_INSTAGRAM_URL=
VYORA_YOUTUBE_URL=
VYORA_X_URL=

# ---- Stripe (leave blank to use demo checkout locally) ---------------------------------------
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# ---- Google sign-in (optional; button is hidden unless all three are set and laravel/socialite is installed)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

VITE_APP_NAME="${APP_NAME}"
